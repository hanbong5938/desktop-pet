{
  "name": "desktop-pet",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Native desktop character companion",
  "scripts": {
    "check": "tsc --noEmit",
    "build:native": "set --; if [ -n \"${DESKTOP_PET_CARGO_TARGET:-}\" ]; then set -- --target \"$DESKTOP_PET_CARGO_TARGET\"; fi; cargo build --release --locked --workspace --target-dir native/target \"$@\" --manifest-path native/Cargo.toml",
    "test:native": "cargo test --locked --workspace --manifest-path native/Cargo.toml",
    "package:native": "bun scripts/package-native.ts",
    "install:local": "bash scripts/install.sh --source"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-util-normalize-identifier": "^2.0.1"
  }
}
